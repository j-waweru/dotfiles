//
// ~/.config/zellij/config.kdl
//

// Use Fish for all new panes
default_shell "fish"

// Open scrollback in Neovim
scrollback_editor "nvim"

// UI
pane_frames true
mouse_mode true
show_startup_tips false

// Restore sessions automatically
session_serialization true

keybinds {
    normal {
        // Tab switching using base-layer symbols with Alt
        bind "Alt ]" { GoToTab 1; }
        bind "Alt }" { GoToTab 2; }
        bind "Alt )" { GoToTab 3; }
        bind "Alt *" { GoToTab 4; }

        // Open the interactive session manager plugin instead of SwitchSession
        bind "PageDown" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
            }
        }
    }
}
