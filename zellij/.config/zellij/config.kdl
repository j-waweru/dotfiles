//
// ~/.config/zellij/config.kdl
//

// Use Fish for all new panes
default_shell "fish"

// Open scrollback in Neovim
scrollback_editor "nvim"

// UI
pane_frames true
mouse_mode true
show_startup_tips false

// Restore sessions automatically
session_serialization true

keybinds {
    normal {
        // Pane movement
        bind "Alt h" { MoveFocus "left"; }
        bind "Alt j" { MoveFocus "down"; }
        bind "Alt k" { MoveFocus "up"; }
        bind "Alt l" { MoveFocus "right"; }

        // Create panes
        bind "Alt v" { NewPane "right"; }
        bind "Alt s" { NewPane "down"; }
        bind "Alt n" { NewPane; }

        // Close pane
        bind "Alt x" { CloseFocus; }

        // Tabs
        bind "Alt t" { NewTab; }
        bind "Alt ," { GoToPreviousTab; }
        bind "Alt ." { GoToNextTab; }

        // Fullscreen
        bind "Alt o" { ToggleFocusFullscreen; }

        // Rename
        bind "Alt r" { SwitchToMode "renamepane"; }
        bind "Alt Shift r" { SwitchToMode "renametab"; }

        // Lock/Unlock
        bind "Alt g" { SwitchToMode "locked"; }

        // Quit Zellij
        bind "Alt q" { Quit; }
    }

    locked {
        bind "Alt g" { SwitchToMode "normal"; }
    }
}
