//qwerty but with the symbols changed for a better programming experience

partial alphanumeric_keys
xkb_symbols "prog-qwerty" {

    name[Group1]= "English (Programmers Qwerty)";

    // Number Row Modifications
    key <TLDE> { [      dollar,  asciitilde,                    dead_grave,  dead_tilde          ] };
    key <AE01> { [        plus,            1                    ] };
    key <AE02> { [   parenleft,            2                    ] };
    key <AE03> { [   braceleft,            3                    ] };
    key <AE04> { [ bracketleft,            4                    ] };
    key <AE05> { [       equal,            5,                   dead_circumflex ,dead_circumflex ] };
    key <AE06> { [   ampersand,            6                    ] };    
    key <AE07> { [bracketright,            7                    ] };
    key <AE08> { [  braceright,            8,                   dead_grave                       ] };
    key <AE09> { [  parenright,            9                    ] };
    key <AE10> { [    asterisk,            0                    ] };
    key <AE11> { [     percent,      exclam                     ] };
    key <AE12> { [         bar,       grave,                    dead_tilde                       ] };
    

    // Top Row
    key <AD01> { [           q ,           Q                    ] };
    key <AD02> { [           w,            W                    ] };
    key <AD03> { [           e,            E                    ] };
    key <AD04> { [           r,            R                    ] };
    key <AD05> { [           t,            T                    ] };
    key <AD06> { [           y,            Y                    ] }; 
    key <AD07> { [           u,            U                    ] }; 
    key <AD08> { [           i,            I                    ] };
    key <AD09> { [           o,            O                    ] };
    key <AD10> { [           p,            P                    ] };
    
    // Modifications
    key <AD11> { [       slash,            numbersign           ] };
    key <AD12> { [       minus,            underscore           ] };
    key <BKSL> { [ asciicircum,            question             ] };

    // Home Row
    key <AC01> { [           a,            A                    ] };
    key <AC02> { [           s,            S                    ] }; 
    key <AC03> { [           d,            D                    ] }; 
    key <AC04> { [           f,            F                    ] };
    key <AC05> { [           g,            G                    ] };
    key <AC06> { [           h,            H                    ] };
    key <AC07> { [           j,            J                    ] };
    key <AC08> { [           k,            K                    ] };
    key <AC09> { [           l,            L                    ] };
    key <AC10> { [   semicolon,            colon,               dead_acute ,dead_diaeresis      ] };
    key <AC11> { [    quotedbl,            apostrophe,          dead_ogonek, dead_doubleacute   ] };
    

    // Bottom Row & Extras
                               
    key <AB01> { [           z,            Z                    ] };
    key <AB02> { [           x,            X                    ] };
    key <AB03> { [           c,            C                    ] };
    key <AB04> { [           v,            V                    ] };
    key <AB05> { [           b,            B                   ] };
    key <AB06> { [           n,            N                    ] };
    key <AB07> { [           m,            M                    ] };
    key <AB08> { [       comma,            less,                dead_cedilla, dead_caron               ] };
    key <AB09> { [      period,            greater,             dead_abovedot, periodcentered          ] }; 
    
    // Modifications
    key <AB10> { [    backslash,           at                   ] };
    

};
