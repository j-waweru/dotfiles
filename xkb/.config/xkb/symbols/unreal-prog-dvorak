// based on Michael Paulson's poor ideas with some of my own tweaks.

partial alphanumeric_keys
xkb_symbols "unreal-prog-dvorak" {

    name[Group1]= "English (UnReal Programmers Dvorak)";

    // Number Row Modifications
    key <TLDE> { [  asciitilde,        grave,   dead_grave,  dead_tilde ] };
    key <AE01> { [        plus,      percent                    ] };
    key <AE02> { [   parenleft,            7                    ] };
    key <AE03> { [   braceleft,            5                    ] };
    key <AE04> { [ bracketleft,            3                    ] };
    key <AE05> { [ bracketright,           1                    ] };
    key <AE06> { [   ampersand,            9, dead_circumflex, dead_circumflex ] };    
    key <AE07> { [       equal,            0                    ] };
    key <AE08> { [  braceright,            2                    ] };
    key <AE09> { [  parenright,            4,   dead_grave      ] };
    key <AE10> { [    asterisk,            6                    ] };
    key <AE11> { [      exclam,            8                    ] };
    key <AE12> { [         bar,       dollar,   dead_tilde      ] };

    // Top Row
    key <AD01> { [      period,         less,   dead_acute, dead_diaeresis ] };
    key <AD02> { [       comma,      greater, dead_cedilla,    dead_caron ] };
    key <AD03> { [   semicolon,        colon, dead_abovedot, periodcentered ] };
    key <AD04> { [           p,            P                    ] };
    key <AD05> { [           y,            Y                    ] };
    key <AD06> { [           g,            G                    ] }; // Swapped in standard Dvorak (usually f)
    key <AD07> { [           f,            F                    ] }; // Swapped in standard Dvorak (usually g)
    key <AD08> { [           c,            C                    ] };
    key <AD09> { [           r,            R                    ] };
    key <AD10> { [           l,            L                    ] };
    key <AD11> { [       slash,   numbersign                    ] };
    key <AD12> { [ silicicircum,    question                    ] };

    // Home Row
    key <AC01> { [           a,            A                    ] };
    key <AC02> { [           e,            E                    ] }; // Swapped in standard Dvorak (usually O)
    key <AC03> { [           o,            O                    ] }; // Swapped in standard Dvorak (usually E)
    key <AC04> { [           u,            U                    ] };
    key <AC05> { [           i,            I                    ] };
    key <AC06> { [           d,            D                    ] };
    key <AC07> { [           h,            H                    ] };
    key <AC08> { [           t,            T                    ] };
    key <AC09> { [           n,            N                    ] };
    key <AC10> { [           s,            S                    ] };
    key <AC11> { [       minus,   underscore                    ] };

    // Bottom Row & Extras
    key <AB01> { [    quotedbl,   apostrophe,  dead_ogonek, dead_doubleacute ] };
    key <AB02> { [           q,            Q                    ] };
    key <AB03> { [           j,            J                    ] };
    key <AB04> { [           k,            K                    ] };
    key <AB05> { [           x,            X                    ] };
    key <AB06> { [           b,            B                    ] };
    key <AB07> { [           m,            M                    ] };
    key <AB08> { [           w,            W                    ] };
    key <AB09> { [           v,            V                    ] };
    key <AB10> { [           z,            Z                    ] };
    
    key <BKSL> { [   backslash,           at                    ] };
};
