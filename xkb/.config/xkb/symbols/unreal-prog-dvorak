// based on Michael Paulson's poor ideas with some of my own tweaks to the symbols.

partial alphanumeric_keys
xkb_symbols "unreal-prog-dvorak" {

    name[Group1]= "English (UnReal Programmers Dvorak)";

    // Number Row
    key <TLDE> { [  asciitilde,       grave,   dead_grave,     dead_tilde ] };
    key <AE01> { [        plus,            7                    ] };
    key <AE02> { [   parenleft,            5                    ] };
    key <AE03> { [   braceleft,            3                    ] };
    key <AE04> { [ bracketleft,            1                    ] };
    key <AE05> { [   ampersand,            9                    ] };
    key <AE06> { [       equal,            0,  dead_circumflex, dead_circumflex ] };
    key <AE07> { [bracketright,            2                    ] };
    key <AE08> { [  braceright,            4                    ] };
    key <AE09> { [  parenright,            6,  dead_grave       ] };
    key <AE10> { [    asterisk,            8                    ] };
    key <AE11> { [     percent,       exclam                    ] };
    key <AE12> { [   backslash,          bar,  dead_tilde       ] };


    // Top Row
    key <AD01> { [   semicolon,       colon,   dead_acute,      dead_diaeresis ] };
    key <AD02> { [       comma,        less,   dead_cedilla,    dead_caron ] };
    key <AD03> { [      period,     greater,   dead_abovedot,   periodcentered ] };
    key <AD04> { [           p,            P                    ] };
    key <AD05> { [           y,            Y                    ] };
    key <AD06> { [           f,            F                    ] }; 
    key <AD07> { [           g,            G                    ] }; 
    key <AD08> { [           c,            C                    ] };
    key <AD09> { [           r,            R                    ] };
    key <AD10> { [           l,            L                    ] };
    key <AD11> { [       slash,   numbersign                    ] };
    key <AD12> { [ asciicircum,       dollar                    ] };

    // Home Row
    key <AC01> { [           a,            A                    ] };
    key <AC02> { [           o,            O                    ] }; 
    key <AC03> { [           e,            E                    ] }; 
    key <AC04> { [           u,            U                    ] };
    key <AC05> { [           i,            I                    ] };
    key <AC06> { [           d,            D                    ] };
    key <AC07> { [           h,            H                    ] };
    key <AC08> { [           t,            T                    ] };
    key <AC09> { [           n,            N                    ] };
    key <AC10> { [           s,            S                    ] };
    key <AC11> { [       minus,   underscore                    ] };

    // Bottom Row & Extras
    key <AB01> { [    quotedbl,   apostrophe,  dead_ogonek,     dead_doubleacute ] };
    key <AB02> { [           q,            Q                    ] };
    key <AB03> { [           j,            J                    ] };
    key <AB04> { [           k,            K                    ] };
    key <AB05> { [           x,            X                    ] };
    key <AB06> { [           b,            B                    ] };
    key <AB07> { [           m,            M                    ] };
    key <AB08> { [           w,            W                    ] };
    key <AB09> { [           v,            V                    ] };
    key <AB10> { [           z,            Z                    ] };
    
    key <BKSL> { [    question,           at                    ] };
};

