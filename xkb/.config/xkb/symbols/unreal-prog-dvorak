// based on Michael Paulson's poor ideas with some of my own tweaks.

//Format:
//Array Index,Modifier Combination,Common Target

//Level 1 (1st Slot),Plain Keypress,Normal lowercase character or symbol
//Level 2 (2nd Slot),Shift + Key,Capital letter or shifted symbol
//Level 3 (3rd Slot),AltGr (or Level3 Chooser) + Key,Custom third-layer symbol / dead key
//Level 4 (4th Slot),Shift + AltGr + Key,Custom fourth-layer symbol / dead key

partial alphanumeric_keys
xkb_symbols "unreal-prog-dvorak" {

    name[Group1]= "English (Unreal Programmers Dvorak)";

    // Level 1: ~, Level 2: `, Level 3: dead_grave, Level 4: dead_tilde
    key <TLDE> { [       asciitilde,        grave, dead_grave, dead_tilde ] };
    
    key <AE01> { [          plus,           percent               ]       };
    key <AE02> { [          parenleft,      7               ]       };
    key <AE03> { [          braceleft,      5               ]       };
    key <AE04> { [          bracketleft,    3               ]       };
    key <AE05> { [          bracketright,   1               ]       };
    key <AE06> { [          ampersand,      9,              dead_circumflex, dead_circumflex ]   };
    key <AE07> { [          equal,          0               ]       };
    key <AE08> { [          braceright,     2               ]       };
    key <AE09> { [          parenright,     4,              dead_grave] };
    key <AE10> { [          asterisk,       6               ]       };
    key <AE11> { [           exclam,        8               ]       };
    
    // Level 1: |, Level 2: $
    key <AE12> { [         bar,  dollar                     ] };

    //key <AD01> { [  semicolon,  colon, dead_acute, dead_diaeresis       ] };
    key <AD01> { [    period,  less, dead_acute, dead_diaeresis       ] };
    
    
    //key <AD02> { [       comma,  less,  dead_cedilla, dead_caron        ] };
    key <AD02> { [       comma,  greater,  dead_cedilla, dead_caron        ] };
    
    //key <AD03> { [      period,  greater, dead_abovedot, periodcentered  ] };
    key <AD03> { [      semicolon,  colon, dead_abovedot, periodcentered  ] };
    
    //key <AD05> { [          p,  P               ]       }; 
    key <AD04> { [          y,  Y               ]       };
    
    key <AD05> { [          p,  P               ]       };    
    //key <AD05> { [          y,  Y               ]       };    
    
    
    
    //key <AD06> { [          f,  F               ]       };
    key <AD06> { [          g,  G               ]       };
    
    //key <AD07> { [          g,  G               ]       };
    key <AD07> { [          f,  F               ]       };
    
    
    key <AD08> { [          c,  C               ]       };
    key <AD09> { [          r,  R               ]       };
    key <AD10> { [          l,  L               ]       };
    key <AD11> { [      slash,  numbersign      ]       };
    key <AD12> { [      minus,  underscore      ]       };

    key <AC01> { [          a,  A               ]       };
    
    
    //key <AC02> { [          o,  O               ]       };
    key <AC02> { [          e,  E               ]       };
    
    //key <AC03> { [          e,  E               ]       };
    key <AC03> { [          o,  O               ]       };
    
    
    key <AC04> { [          u,  U               ]       };
    key <AC05> { [          i,  I               ]       };
    key <AC06> { [          d,  D               ]       };
    key <AC07> { [          h,  H               ]       };
    key <AC08> { [          t,  T               ]       };
    key <AC09> { [          n,  N               ]       };
    key <AC10> { [          s,  S               ]       };
    
    // Level 1: ", Level 2: ', Level 3: dead_ogonek, Level 4: dead_doubleacute
    key <AC11> { [   quotedbl, apostrophe, dead_ogonek, dead_doubleacute ] };
    
    // Level 1: ^, Level 2: @
    key <AB01> { [      asciicircum, at         ]       };   
      
    key <AB02> { [          q,  Q               ]       };
    key <AB03> { [          j,  J               ]       };
    key <AB04> { [          k,  K               ]       }; 
    
    key <AB05> { [          x,  X               ]       };    
    
    key <AB06> { [          b,  B               ]       };
    key <AB07> { [          m,  M               ]       };
    key <AB08> { [          w,  W               ]       };
    key <AB09> { [          v,  V               ]       };
    key <AB10> { [          z,  Z               ]       };

    key <BKSL> { [  backslash, question         ]       };
};

