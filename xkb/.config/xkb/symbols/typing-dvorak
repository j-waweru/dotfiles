
partial alphanumeric_keys
xkb_symbols "typing-dvorak" {

    name[Group1]= "English (Typing Dvorak)";

    // Number Row
    key <TLDE> { [  asciitilde,        grave,                   dead_grave,      dead_tilde        ] };
    key <AE01> { [           7,    backslash                    ] };   
    key <AE02> { [           5,    parenleft                    ] };
    key <AE03> { [           3,    braceleft                    ] };
    key <AE04> { [           1,  bracketleft                    ] };
    key <AE05> { [           9,        equal                    ] };
    key <AE06> { [           0,    ampersand,                   dead_circumflex, dead_circumflex   ] };
    key <AE07> { [           2, bracketright                    ] };
    key <AE08> { [           4,   braceright                    ] };
    key <AE09> { [           6,   parenright,                   dead_grave                         ] };
    key <AE10> { [           8,      percent                    ] };
    key <AE11> { [      exclam,          bar,                   dead_tilde                         ] };
    key <AE12> { [        plus,     asterisk                    ] };


    // Top Row
    key <AD01> { [   semicolon,        colon,                   dead_acute,       dead_diaeresis   ] };
    key <AD02> { [       comma,         less,                   dead_cedilla,     dead_caron       ] };
    key <AD03> { [      period,      greater,                   dead_abovedot,    periodcentered   ] };
    key <AD04> { [           p,            P                    ] };
    key <AD05> { [           y,            Y                    ] };
    key <AD06> { [           f,            F                    ] }; 
    key <AD07> { [           g,            G                    ] }; 
    key <AD08> { [           c,            C                    ] };
    key <AD09> { [           r,            R                    ] };
    key <AD10> { [           l,            L                    ] };

    key <AD11> { [    question,           at                    ] }; 
    key <AD12> { [      dollar,  asciicircum                    ] };

    // Home Row
    key <AC01> { [           a,            A                    ] };
    key <AC02> { [           o,            O                    ] }; 
    key <AC03> { [           e,            E                    ] }; 
    key <AC04> { [           u,            U                    ] };
    key <AC05> { [           i,            I                    ] };
    key <AC06> { [           d,            D                    ] };
    key <AC07> { [           h,            H                    ] };
    key <AC08> { [           t,            T                    ] };
    key <AC09> { [           n,            N                    ] };
    key <AC10> { [           s,            S                    ] };
    key <AC11> { [       minus,   underscore                    ] };

    // Bottom Row & Extras
    key <AB01> { [  apostrophe,     quotedbl,                   dead_ogonek,      dead_doubleacute    ] };
    key <AB02> { [           q,            Q                    ] };
    key <AB03> { [           j,            J                    ] };
    key <AB04> { [           k,            K                    ] };
    key <AB05> { [           x,            X                    ] };
    key <AB06> { [           b,            B                    ] };
    key <AB07> { [           m,            M                    ] };
    key <AB08> { [           w,            W                    ] };
    key <AB09> { [           v,            V                    ] };
    key <AB10> { [           z,            Z                    ] };
    
    key <BKSL> { [       slash,   numbersign                    ] };
};

