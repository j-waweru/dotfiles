(defcfg
  process-unmapped-keys yes
)

;; ============================================================
;; PHYSICAL US QWERTY KEYBOARD
;; ============================================================

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt            spc             ralt rmet rctl
)


;; ============================================================
;; FAKE KEYS
;; ============================================================

(deffakekeys
  shiftlock (layer-while-held shift)
)


;; ============================================================
;; ALIASES
;; ============================================================

(defalias

  ;; Number-row symbols
  tilde     S-grv
  lparen    S-9
  lbrace    S-[
  bang      S-1
  rbrace    S-]
  rparen    S-0
  percent   S-5
  plus      S-=
  asterisk  S-8
  ampersand S-7
  bar       S-\

  ;; Punctuation symbols
  colon     S-;
  less      S-,
  greater   S-.
  hash      S-3
  dollar    S-4
  caret     S-6
  at        S-2

  ;; Caps Lock -> Tap = Esc, Hold = Left Control
  capsctl
    (tap-hold 200 200 esc lctl)

  ;; Left Alt -> Tap = Backspace, Hold = Left Alt
  altbs
    (tap-hold 200 200 bspc lalt)

  ;; Right Alt -> Tap = Enter, Hold = Right Alt
  altgrENT
    (tap-hold 200 200 ret ralt)

  ;; Space -> Tap = Space, Hold = Shift layer
  spcsft
    (tap-hold 200 200 spc (layer-while-held shift))

  ;; Dvorak A (Physical A) -> Tap = a, Hold = Nav Layer (400ms)
  anav
    (tap-hold 400 400 a (layer-while-held nav))
  anavS
    (tap-hold 400 400 S-a (layer-while-held nav))

  ;; Dvorak O (Physical S) -> Tap = o, Hold = Home (300ms)
  ohome
    (tap-hold 300 300 o home)
  ohomeS
    (tap-hold 300 300 S-o home)

  ;; Dvorak E (Physical D) -> Tap = e, Hold = End (300ms)
  eend
    (tap-hold 300 300 e end)
  eendS
    (tap-hold 300 300 S-e end)

  ;; Dvorak S (Physical ;) -> Tap = s, Hold = Nav Layer (400ms)
  snav
    (tap-hold 400 400 s (layer-while-held nav))
  snavS
    (tap-hold 400 400 S-s (layer-while-held nav))

  ;; Dvorak - (Physical ') -> Tap = -, Hold = Left Control
  minusctl
    (tap-hold-press 200 200 - lctl)
  minusctlS
    (tap-hold-press 200 200 S-- lctl)

  ;; Enter (Physical Ret) -> Tap = Enter, Hold = Windows Key
  entwin
    (tap-hold-press 200 200 ret lmet)

  ;; Persistent Shift Toggle on Right Shift
  shifttog
    (on-press-fakekey shiftlock toggle)
)


;; ============================================================
;; BASE LAYER
;; ============================================================

(deflayer base
  @tilde  \  @lparen  @lbrace  [  =  @bang  ]  @rbrace  @rparen  @percent  @plus  @ampersand  bspc
  tab  ;  ,  .  p  y  f  g  c  r  l  /  @caret  S-/
  @capsctl  @anav  @ohome  @eend  u  i  d  h  t  n  @snav  @minusctl  @entwin
  lsft  S-'  q  j  k  x  b  m  w  v  z  @shifttog
  lctl  lmet  @altbs  @spcsft  @altgrENT  rmet  rctl
)


;; ============================================================
;; SHIFT LAYER
;; ============================================================

(deflayer shift
  grv  7  5  3  1  9  0  2  4  6  8  @asterisk  @bar  bspc
  tab  @colon  @less  @greater  S-p  S-y  S-f  S-g  S-c  S-r  S-l  @hash  @dollar  @at
  @capsctl  @anavS  @ohomeS  @eendS  S-u  S-i  S-d  S-h  S-t  S-n  @snavS  @minusctlS  @entwin
  lsft  '  S-q  S-j  S-k  S-x  S-b  S-m  S-w  S-v  S-z  @shifttog
  lctl  lmet  @altbs  @spcsft  @altgrENT  rmet  rctl
)


;; ============================================================
;; NAVIGATION LAYER
;; ============================================================

(deflayer nav
  _  _  _  _  _  _  _  _  _  _  _  _  _  _
  _  _  _  _  _  _  _  _  _  _  right  _  _  _
  _  _  home  end  _  _  _  left  _  _  _  _  _
  _  _  _  down  up  _  _  _  _  _  _  _
  _  _  _  _  _  _  _
)