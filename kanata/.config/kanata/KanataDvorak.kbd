(defcfg
  process-unmapped-keys yes
)

(defsrc
  grv 1 2 3 4 5 6 7 8 9 0 min = bspc
  tab q w e r t y u i o p [ ] \
  caps a s d f g h j k l ; ' ret
  lsft z x c v b n m , . / rsft
  lctl lmet lalt spc ralt rmet rctl
)

(defalias
  ;; ============================================================
  ;; BASE / GENERAL FUNCTIONS
  ;; ============================================================

  ;; Caps: tap = Esc, hold = Ctrl
  ;; Temporarily leave persistent Shift layer while Ctrl is held
  capsctl (tap-hold 200 200 esc
    (multi lctl (layer-while-held base))
  )

  ;; Left Alt: tap = Backspace, hold = Left Alt
  altbs (tap-hold 200 200 bspc lalt)

  ;; Right Alt: tap = Enter, hold = Right Alt
  altgrENT (tap-hold 200 200 ret ralt)

  ;; Space: tap = Space, hold = temporary Shift layer
  spcshift (tap-hold 200 200 spc
    (layer-while-held shift)
  )

  ;; A: tap = A, hold = Nav layer
  anav (tap-hold 400 400 a
    (layer-while-held nav)
  )

  ;; S: tap = S, hold = Home
  ohome (tap-hold 300 300 s home)

  ;; D: tap = D, hold = End
  eend (tap-hold 300 300 d end)

  ;; ;: tap = ;, hold = Nav layer
  snav (tap-hold 400 400 ;
    (layer-while-held nav)
  )

  ;; Quote key: tap = ', hold = Ctrl
  ;; Temporarily leave persistent Shift layer while Ctrl is held
  quotectl (tap-hold-press 200 200 '
    (multi lctl (layer-while-held base))
  )

  ;; Enter: tap = Enter, hold = Left Meta/Windows
  ;; Temporarily leave persistent Shift layer while Windows key is held
  entwin (tap-hold-press 200 200 ret
    (multi lmet (layer-while-held base))
  )

  ;; ============================================================
  ;; SHIFT-LAYER SPECIAL KEYS
  ;; ============================================================

  ;; Left Alt: tap = Backspace, hold = Left Alt
  ;; Temporarily leave persistent Shift layer while Alt is held
  shift-altbs (tap-hold 200 200 bspc
    (multi lalt (layer-while-held base))
  )

  ;; Right Alt: tap = Enter, hold = Right Alt
  ;; Temporarily leave persistent Shift layer while AltGr is held
  shift-altgrENT (tap-hold 200 200 ret
    (multi ralt (layer-while-held base))
  )

  ;; ============================================================
  ;; SHIFT-LAYER NAVIGATION
  ;; ============================================================

  ;; A: tap = Shift+A, hold = Nav
  shiftnav-a (tap-hold 400 400 S-a
    (layer-while-held nav)
  )

  ;; S: tap = Shift+S, hold = Home
  shiftnav-s (tap-hold 300 300 S-s home)

  ;; D: tap = Shift+D, hold = End
  shiftnav-d (tap-hold 300 300 S-d end)

  ;; ;: tap = Shift+;, hold = Nav
  shiftnav-semicolon (tap-hold 400 400 S-;
    (layer-while-held nav)
  )

  ;; ============================================================
  ;; RIGHT SHIFT PERSISTENT TOGGLE
  ;; ============================================================

  shifton (layer-switch shift)
  shiftoff (layer-switch base)
)

(deflayer base
  _ _ _ _ _ _ _ _ _ _ _ _ _ _

  _ _ _ _ _ _ _ _ _ _ _ _ _ _

  @capsctl @anav @ohome @eend _ _ _ _ _ _ @snav @quotectl @entwin

  lsft _ _ _ _ _ _ _ _ _ _ @shifton

  lctl lmet @altbs @spcshift @altgrENT rmet rctl
)

(deflayer nav
  _ _ _ _ _ _ _ _ _ _ _ _ _ _

  _ _ _ _ _ _ _ _ _ _ right _ _ _

  _ _ home end _ _ _ left _ _ _ _ _

  _ _ _ down up _ _ _ _ _ _ _

  _ _ _ _ _ _ _
)

(deflayer shift
  S-grv S-1 S-2 S-3 S-4 S-5 S-6 S-7 S-8 S-9 S-0 S-min S-= S-bspc

  S-tab S-q S-w S-e S-r S-t S-y S-u S-i S-o S-p S-[ S-] S-\

  @capsctl @shiftnav-a @shiftnav-s @shiftnav-d S-f S-g S-h S-j S-k S-l @shiftnav-semicolon S-' S-ret

  lsft S-z S-x S-c S-v S-b S-n S-m S-, S-. S-/ @shiftoff

  S-lctl S-lmet @shift-altbs @spcshift @shift-altgrENT S-rmet S-rctl
)